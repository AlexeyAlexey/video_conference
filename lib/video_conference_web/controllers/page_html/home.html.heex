<div class="min-h-screen bg-base-200">
  <div class="max-w-4xl mx-auto p-4 space-y-4">
    <div class="navbar bg-base-100 rounded-box">
      <div class="flex-none mr-2">
        <button
          id="copySharedRoomLink"
          class="btn btn-ghost btn-circle btn-sm"
          aria-label="Copy"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <div class="flex-1">
        <span class="text-lg font-semibold">WebCodecs Capture → Encode</span>
      </div>
      <div class="flex-none gap-2">
        <button
          id="startBtn"
          class="btn btn-primary btn-sm"
          data-auth-token={@http3_server_token}
        >
          Start
        </button>
      </div>
    </div>

    <div class="space-y-3 p-3 rounded-box bg-base-100">
      <div class="text-sm font-medium opacity-80">Room</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label"><span class="label-text">Room ID</span></label>
          <input
            id="roomId"
            name="roomId"
            value={@room_id}
            type="text"
            placeholder="room-123"
            class="input input-bordered input-sm w-full"
          />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Participant ID</span></label>
          <input
            id="participantId"
            name="participantId"
            value={@participant_id}
            type="number"
            inputmode="numeric"
            placeholder="1"
            class="input input-bordered input-sm w-full"
          />
        </div>
      </div>
    </div>

    <details class="collapse bg-base-100 rounded-box">
      <summary class="collapse-title text-md font-medium">Settings</summary>
      <div class="collapse-content">
        <form id="settingsForm" class="space-y-5">
          <div class="space-y-3 p-3 rounded-box bg-base-200">
            <div class="text-sm font-medium opacity-80">Stream server</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text">Host</span></label>
                <input
                  id="streamHost"
                  name="streamHost"
                  value={@http3_host}
                  type="text"
                  placeholder="stream.example.com"
                  class="input input-bordered input-sm w-full"
                />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Port</span></label>
                <input
                  id="streamPort"
                  name="streamPort"
                  value={@http3_port}
                  type="number"
                  inputmode="numeric"
                  placeholder="443"
                  class="input input-bordered input-sm w-full"
                />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Cert Hash</span></label>
                <input
                  id="streamCertHash"
                  name="streamCertHash"
                  value={@http3_server_cert_hash}
                  type="text"
                  placeholder="380f661e9e24c0b9bcb2d760302e8290417fafa3227cb967f41ddd5a7a9ac5bb"
                  class="input input-bordered input-sm w-full"
                />
              </div>
            </div>
          </div>

          <div class="space-y-3 p-3 rounded-box bg-base-200">
            <div class="text-sm font-medium opacity-80">Manager server</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="form-control">
                <label class="label"><span class="label-text">Protocol</span></label>
                <select id="managerProtocol" class="input input-bordered input-sm w-full">
                  <option value="ws" selected={@manager_protocol == "ws"}>ws</option>
                  <option value="wss" selected={@manager_protocol == "wss"}>
                    wss
                  </option>
                </select>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Host</span></label>
                <input
                  id="managerHost"
                  name="managerHost"
                  value={@manager_host}
                  type="text"
                  placeholder="manager.example.com"
                  class="input input-bordered input-sm w-full"
                />
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Port</span></label>
                <input
                  id="managerPort"
                  name="managerPort"
                  value={@manager_port}
                  type="number"
                  inputmode="numeric"
                  placeholder="443"
                  class="input input-bordered input-sm w-full"
                />
              </div>
            </div>
          </div>
        </form>
      </div>
    </details>

    <div
      id="videoGrid"
      class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
    >
      <%!-- <video
        id="preview"
        class="w-full rounded-box bg-black aspect-video object-contain"
        autoplay
        muted
        playsinline
      >
      </video> --%>
      <%!-- <video
        id="decoded"
        class="w-full rounded-box bg-black aspect-video object-contain"
        autoplay
        muted
        playsinline
      >
      </video> --%>
      <!-- Add more <video class="w-full rounded-box bg-black aspect-video object-contain"></video> here; grid adapts automatically -->
      <div class="relative">
        <video
          id={"#{@participant_id}"}
          class="w-full rounded-box bg-black aspect-video object-contain"
          muted
          autoplay
          playsinline
        >
        </video>
        <div class="absolute bottom-1 right-1 flex items-center gap-1">
          <button id="videoToggleBtn" class="btn btn-circle btn-xs">
            <span id="previewIconOn" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3 h-3"
              >
                <rect x="3" y="7" width="12" height="10" rx="2" ry="2"></rect>
                <path d="M21 7l-6 4v2l6 4V7z"></path>
              </svg>
            </span>
            <span id="previewIconOff" class="hidden" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3 h-3"
              >
                <rect x="3" y="7" width="12" height="10" rx="2" ry="2"></rect>
                <path d="M21 7l-6 4v2l6 4V7z"></path>
                <path d="M2 2l20 20"></path>
              </svg>
            </span>
          </button>
          <button id="audioToggleBtn" class="btn btn-circle btn-xs">
            <span id="previewAudioIconOn" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3 h-3"
              >
                <path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <path d="M12 19v2"></path>
              </svg>
            </span>
            <span id="previewAudioIconOff" class="hidden" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3 h-3"
              >
                <path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <path d="M12 19v2"></path>
                <path d="M2 2l20 20"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
